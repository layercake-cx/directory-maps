{
  "version": "0.2",
  "status": "phase 2: derived from the Discover pages handoff v0.1, adapted to this codebase",
  "regions": {
    "hero": {
      "label": "Hero",
      "width": "full"
    },
    "main": {
      "label": "Main",
      "width": "flexible (~2/3)"
    },
    "sidebar": {
      "label": "Sidebar",
      "width": "min 320px, optional sticky"
    }
  },
  "commonFields": [
    {
      "key": "anchorId",
      "label": "Anchor ID",
      "type": "slug"
    },
    {
      "key": "theme",
      "label": "Theme",
      "type": "enum",
      "options": [
        "default",
        "inverse",
        "accent"
      ]
    },
    {
      "key": "spacingAbove",
      "label": "Spacing above",
      "type": "tokenRef",
      "scale": "--ds-space-*"
    },
    {
      "key": "spacingBelow",
      "label": "Spacing below",
      "type": "tokenRef",
      "scale": "--ds-space-*"
    },
    {
      "key": "visibility",
      "label": "Visibility",
      "type": "enum",
      "options": [
        "all",
        "desktop",
        "mobile"
      ],
      "default": "all"
    }
  ],
  "blocks": [
    {
      "id": "hero",
      "name": "Hero banner",
      "group": "structured",
      "allowedRegions": [
        "hero"
      ],
      "purpose": "Introduces the page; first call to action.",
      "fields": [
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "required": true,
          "maxLength": 40,
          "note": "Renders as the page H1"
        },
        {
          "key": "intro",
          "label": "Intro",
          "type": "textarea",
          "maxLength": 160
        },
        {
          "key": "icon",
          "label": "Icon",
          "type": "icon"
        },
        {
          "key": "showBreadcrumb",
          "label": "Show breadcrumb",
          "type": "boolean",
          "default": true,
          "note": "Breadcrumb built from page hierarchy"
        },
        {
          "key": "media",
          "label": "Background media",
          "type": "enum",
          "options": [
            "image",
            "none"
          ],
          "default": "image"
        },
        {
          "key": "mediaAsset",
          "label": "Media asset",
          "type": "image",
          "requiredWhen": "media!='none'",
          "altTextRequired": true
        },
        {
          "key": "overlay",
          "label": "Overlay",
          "type": "enum",
          "options": [
            "left-fade",
            "bottom-fade",
            "full",
            "none"
          ],
          "default": "left-fade"
        },
        {
          "key": "primaryAction",
          "label": "Primary action",
          "type": "link"
        },
        {
          "key": "secondaryAction",
          "label": "Secondary action",
          "type": "link"
        }
      ],
      "variants": {
        "height": [
          "S",
          "M",
          "L"
        ],
        "align": [
          "left",
          "centre"
        ],
        "theme": [
          "inverse",
          "default"
        ]
      },
      "tokens": [
        "--ds-hero-min-height",
        "--ds-color-inverse-bg",
        "--ds-color-on-inverse",
        "--ds-overlay",
        "--ds-font-display",
        "--ds-text-display",
        "--ds-button-primary-bg"
      ],
      "slots": [
        {
          "key": "tags",
          "accepts": [
            "tags"
          ],
          "max": 1
        }
      ],
      "pageKinds": [
        "entry",
        "content_page"
      ],
      "maxPerPage": 1
    },
    {
      "id": "tags",
      "name": "Tag list",
      "group": "structured",
      "allowedRegions": [
        "hero",
        "main"
      ],
      "purpose": "Shows the entry's taxonomy terms as chips. Editors choose sources, not text.",
      "fields": [
        {
          "key": "sources",
          "label": "Sources",
          "type": "multiEnum",
          "options": [
            "category",
            "attributes",
            "region"
          ],
          "default": [
            "category",
            "attributes"
          ]
        },
        {
          "key": "link",
          "label": "Link behaviour",
          "type": "enum",
          "options": [
            "filtered-listing",
            "none"
          ],
          "default": "filtered-listing"
        },
        {
          "key": "maxShown",
          "label": "Max shown",
          "type": "number",
          "min": 1,
          "max": 12,
          "default": 6,
          "note": "Overflow collapses to +n"
        },
        {
          "key": "highlight",
          "label": "Highlighted term",
          "type": "taxonomyRef"
        }
      ],
      "variants": {
        "style": [
          "filled",
          "outline"
        ],
        "size": [
          "S",
          "M"
        ]
      },
      "tokens": [
        "--ds-color-category-{slug}",
        "--ds-radius-sm",
        "--ds-text-label",
        "--ds-tracking-label"
      ],
      "pageKinds": [
        "entry"
      ]
    },
    {
      "id": "stats",
      "name": "Stat list",
      "group": "structured",
      "allowedRegions": [
        "hero",
        "main"
      ],
      "purpose": "Two to four short, checkable facts.",
      "fields": [
        {
          "key": "title",
          "label": "Block title",
          "type": "text"
        },
        {
          "key": "items",
          "label": "Items",
          "type": "list",
          "min": 1,
          "max": 4,
          "itemFields": [
            {
              "key": "value",
              "label": "Value",
              "type": "text",
              "required": true,
              "maxLength": 12
            },
            {
              "key": "label",
              "label": "Label",
              "type": "text",
              "maxLength": 40
            }
          ]
        },
        {
          "key": "overlapPrevious",
          "label": "Overlap previous block",
          "type": "boolean",
          "default": false
        }
      ],
      "variants": {
        "style": [
          "card",
          "plain"
        ],
        "valueColour": [
          "category",
          "ink"
        ]
      },
      "tokens": [
        "--ds-color-surface",
        "--ds-shadow-1",
        "--ds-text-stat",
        "--ds-radius-lg"
      ],
      "pageKinds": [
        "entry",
        "content_page"
      ]
    },
    {
      "id": "cards",
      "name": "Card grid",
      "group": "structured",
      "allowedRegions": [
        "main"
      ],
      "purpose": "Reasons, options, formats. Reused with different themes.",
      "fields": [
        {
          "key": "title",
          "label": "Block title",
          "type": "text"
        },
        {
          "key": "headingLevel",
          "label": "Heading level",
          "type": "enum",
          "options": [
            "h2",
            "h3"
          ],
          "default": "h2"
        },
        {
          "key": "items",
          "label": "Items",
          "type": "list",
          "min": 2,
          "max": 8,
          "itemFields": [
            {
              "key": "icon",
              "label": "Icon",
              "type": "icon"
            },
            {
              "key": "heading",
              "label": "Heading",
              "type": "text",
              "required": true,
              "maxLength": 40
            },
            {
              "key": "body",
              "label": "Body",
              "type": "richTextBasic",
              "maxLength": 200
            },
            {
              "key": "link",
              "label": "Link",
              "type": "link"
            }
          ]
        },
        {
          "key": "columns",
          "label": "Columns",
          "type": "enum",
          "options": [
            "auto",
            "2",
            "3",
            "4"
          ],
          "default": "auto"
        }
      ],
      "variants": {
        "theme": [
          "default",
          "inverse"
        ],
        "card": [
          "filled",
          "outline"
        ],
        "density": [
          "comfortable",
          "compact"
        ]
      },
      "tokens": [
        "--ds-color-surface",
        "--ds-color-inverse-bg",
        "--ds-radius-lg",
        "--ds-color-icon-bg",
        "--ds-color-icon",
        "--ds-space-5"
      ],
      "pageKinds": [
        "entry",
        "content_page"
      ]
    },
    {
      "id": "media",
      "name": "Media and list",
      "group": "structured",
      "allowedRegions": [
        "main"
      ],
      "purpose": "Image beside a short ordered or unordered list.",
      "fields": [
        {
          "key": "title",
          "label": "Block title",
          "type": "text"
        },
        {
          "key": "media",
          "label": "Media",
          "type": "image",
          "altTextRequired": true
        },
        {
          "key": "mediaPosition",
          "label": "Media position",
          "type": "enum",
          "options": [
            "left",
            "right"
          ],
          "default": "left"
        },
        {
          "key": "listStyle",
          "label": "List style",
          "type": "enum",
          "options": [
            "numbered",
            "bulleted",
            "checklist"
          ],
          "default": "numbered"
        },
        {
          "key": "items",
          "label": "Items",
          "type": "list",
          "min": 1,
          "max": 6,
          "itemFields": [
            {
              "key": "heading",
              "label": "Heading",
              "type": "text",
              "required": true
            },
            {
              "key": "body",
              "label": "Body",
              "type": "text"
            }
          ]
        }
      ],
      "variants": {
        "mediaTilt": [
          "on",
          "off"
        ]
      },
      "tokens": [
        "--ds-radius-lg",
        "--ds-tilt-angle",
        "--ds-marker-bg",
        "--ds-marker-fg"
      ],
      "pageKinds": [
        "entry",
        "content_page"
      ]
    },
    {
      "id": "attrs",
      "name": "Attribute list",
      "group": "structured",
      "allowedRegions": [
        "sidebar",
        "main"
      ],
      "purpose": "Explains each of the entry's attributes in its own terms; reads the same taxonomy as Tag list.",
      "fields": [
        {
          "key": "title",
          "label": "Block title",
          "type": "text",
          "default": "Is it for me?"
        },
        {
          "key": "source",
          "label": "Source",
          "type": "enum",
          "options": [
            "page-attributes",
            "manual"
          ],
          "default": "page-attributes"
        },
        {
          "key": "descriptions",
          "label": "Per-attribute descriptions",
          "type": "map",
          "keyType": "taxonomyRef",
          "valueType": "text",
          "note": "Overrides the default description per entry"
        },
        {
          "key": "footerLink",
          "label": "Footer link",
          "type": "link"
        }
      ],
      "variants": {
        "theme": [
          "inverse",
          "default"
        ]
      },
      "tokens": [
        "--ds-color-inverse-bg",
        "--ds-color-accent",
        "--ds-color-on-accent",
        "--ds-radius-xl"
      ],
      "pageKinds": [
        "entry"
      ]
    },
    {
      "id": "actions",
      "name": "Action list",
      "group": "structured",
      "allowedRegions": [
        "sidebar",
        "main"
      ],
      "purpose": "Linked next steps; the main conversion point.",
      "fields": [
        {
          "key": "title",
          "label": "Block title",
          "type": "text",
          "required": true
        },
        {
          "key": "subtitle",
          "label": "Subtitle",
          "type": "text"
        },
        {
          "key": "headerStyle",
          "label": "Header style",
          "type": "enum",
          "options": [
            "accent-band",
            "plain"
          ],
          "default": "accent-band"
        },
        {
          "key": "items",
          "label": "Items",
          "type": "list",
          "min": 1,
          "max": 6,
          "itemFields": [
            {
              "key": "icon",
              "label": "Icon",
              "type": "icon"
            },
            {
              "key": "label",
              "label": "Label",
              "type": "text",
              "required": true
            },
            {
              "key": "sublabel",
              "label": "Sublabel",
              "type": "text"
            },
            {
              "key": "link",
              "label": "Link",
              "type": "link",
              "required": true
            }
          ]
        },
        {
          "key": "sticky",
          "label": "Sticky in sidebar",
          "type": "boolean",
          "default": false,
          "note": "Only applies in sidebar region"
        }
      ],
      "variants": {
        "header": [
          "accent",
          "plain"
        ]
      },
      "tokens": [
        "--ds-color-accent",
        "--ds-color-on-accent",
        "--ds-shadow-2",
        "--ds-sticky-offset",
        "--ds-color-icon-bg"
      ],
      "slots": [
        {
          "key": "footer",
          "accepts": [
            "chips"
          ],
          "max": 1
        }
      ],
      "pageKinds": [
        "entry",
        "content_page"
      ]
    },
    {
      "id": "chips",
      "name": "Chip list",
      "group": "structured",
      "allowedRegions": [
        "sidebar",
        "main"
      ],
      "purpose": "Short plain-text items (kit lists, formats).",
      "fields": [
        {
          "key": "title",
          "label": "Label",
          "type": "text"
        },
        {
          "key": "items",
          "label": "Items",
          "type": "textList",
          "min": 1,
          "max": 8,
          "itemMaxLength": 30
        }
      ],
      "variants": {
        "style": [
          "pill",
          "outline"
        ]
      },
      "tokens": [
        "--ds-color-subtle-bg",
        "--ds-radius-pill",
        "--ds-text-small"
      ],
      "pageKinds": [
        "entry",
        "content_page"
      ]
    },
    {
      "id": "contact",
      "name": "Contact block",
      "group": "structured",
      "allowedRegions": [
        "sidebar",
        "main"
      ],
      "purpose": "Generic organisation card backed by an Organisation record.",
      "fields": [
        {
          "key": "title",
          "label": "Block title",
          "type": "text",
          "note": "e.g. Governed by, Partner, Run by"
        },
        {
          "key": "organisation",
          "label": "Organisation",
          "type": "recordRef",
          "recordType": "organisation",
          "required": true
        },
        {
          "key": "fieldsShown",
          "label": "Fields shown",
          "type": "multiEnum",
          "options": [
            "logo",
            "website",
            "email",
            "phone",
            "address",
            "social"
          ],
          "default": [
            "logo",
            "website"
          ]
        },
        {
          "key": "websiteLabel",
          "label": "Website link label",
          "type": "text",
          "default": "Visit website"
        }
      ],
      "variants": {
        "layout": [
          "compact",
          "full"
        ],
        "logoSize": [
          "S",
          "M"
        ]
      },
      "tokens": [
        "--ds-color-surface",
        "--ds-logo-size",
        "--ds-radius-md",
        "--ds-color-ink-muted",
        "--ds-color-border"
      ],
      "pageKinds": [
        "entry",
        "content_page"
      ],
      "status": "deferred",
      "deferredReason": "Needs Organisation records, which do not exist yet."
    },
    {
      "id": "claim",
      "name": "Claim prompt",
      "group": "structured",
      "allowedRegions": [
        "hero",
        "main",
        "sidebar"
      ],
      "purpose": "Invites the organisation behind an entry to claim it.",
      "fields": [
        {
          "key": "title",
          "label": "Heading",
          "type": "text",
          "required": true,
          "mergeFields": [
            "entry.name",
            "entry.short_name"
          ]
        },
        {
          "key": "body",
          "label": "Body",
          "type": "textarea",
          "maxLength": 200,
          "mergeFields": [
            "entry.name",
            "entry.short_name"
          ]
        },
        {
          "key": "icon",
          "label": "Icon",
          "type": "icon"
        },
        {
          "key": "primaryAction",
          "label": "Primary action",
          "type": "link"
        },
        {
          "key": "secondaryLink",
          "label": "Secondary link",
          "type": "link"
        },
        {
          "key": "actionMode",
          "label": "Action mode",
          "type": "enum",
          "options": [
            "link-out",
            "inline-form"
          ],
          "default": "link-out"
        },
        {
          "key": "formFields",
          "label": "Form fields",
          "type": "multiEnum",
          "options": [
            "name",
            "email",
            "role",
            "website",
            "message"
          ],
          "default": [
            "name",
            "email",
            "message"
          ],
          "requiredWhen": "actionMode=='inline-form'"
        },
        {
          "key": "layout",
          "label": "Layout",
          "type": "enum",
          "options": [
            "auto",
            "banner",
            "stacked"
          ],
          "default": "auto",
          "note": "auto = banner in hero/main, stacked in sidebar"
        }
      ],
      "variants": {
        "tone": [
          "neutral",
          "accent"
        ],
        "emphasisEdge": [
          "left",
          "top",
          "none"
        ],
        "dismissible": [
          "yes",
          "no"
        ]
      },
      "tokens": [
        "--ds-color-subtle-bg",
        "--ds-color-callout-edge",
        "--ds-color-ink",
        "--ds-button-primary-bg",
        "--ds-radius-md",
        "--ds-space-4"
      ],
      "visibilityRule": "entry.claimed == false",
      "pageKinds": [
        "entry"
      ]
    },
    {
      "id": "rich",
      "name": "Rich text",
      "group": "text",
      "allowedRegions": [
        "main"
      ],
      "purpose": "Paragraphs of editorial copy.",
      "fields": [
        {
          "key": "title",
          "label": "Heading",
          "type": "text"
        },
        {
          "key": "body",
          "label": "Body",
          "type": "richText",
          "marks": [
            "bold",
            "italic",
            "link",
            "bulletList",
            "orderedList"
          ]
        },
        {
          "key": "style",
          "label": "Style",
          "type": "enum",
          "options": [
            "normal",
            "lead"
          ],
          "default": "normal"
        }
      ],
      "variants": {},
      "tokens": [
        "--ds-text-body",
        "--ds-measure",
        "--ds-color-link"
      ],
      "pageKinds": [
        "entry",
        "content_page"
      ]
    },
    {
      "id": "heading",
      "name": "Heading",
      "group": "text",
      "allowedRegions": [
        "main"
      ],
      "purpose": "Standalone section heading; creates an anchor.",
      "fields": [
        {
          "key": "title",
          "label": "Text",
          "type": "text",
          "required": true,
          "maxLength": 60
        },
        {
          "key": "level",
          "label": "Level",
          "type": "enum",
          "options": [
            "h2",
            "h3",
            "h4"
          ],
          "default": "h2"
        },
        {
          "key": "eyebrow",
          "label": "Eyebrow",
          "type": "text"
        }
      ],
      "variants": {
        "case": [
          "upper",
          "sentence"
        ]
      },
      "tokens": [
        "--ds-font-display",
        "--ds-text-h2",
        "--ds-case-heading"
      ],
      "pageKinds": [
        "entry",
        "content_page"
      ]
    },
    {
      "id": "list",
      "name": "List",
      "group": "text",
      "allowedRegions": [
        "main"
      ],
      "purpose": "Plain list without media.",
      "fields": [
        {
          "key": "title",
          "label": "Heading",
          "type": "text"
        },
        {
          "key": "items",
          "label": "Items",
          "type": "textList",
          "min": 1,
          "max": 20
        },
        {
          "key": "listStyle",
          "label": "Style",
          "type": "enum",
          "options": [
            "bulleted",
            "numbered",
            "checklist"
          ],
          "default": "bulleted"
        }
      ],
      "variants": {
        "columns": [
          "1",
          "2"
        ]
      },
      "tokens": [
        "--ds-marker-bg",
        "--ds-marker-fg",
        "--ds-space-3"
      ],
      "pageKinds": [
        "entry",
        "content_page"
      ]
    },
    {
      "id": "quote",
      "name": "Quote",
      "group": "text",
      "allowedRegions": [
        "main"
      ],
      "purpose": "A real, attributed quote.",
      "fields": [
        {
          "key": "title",
          "label": "Quote",
          "type": "textarea",
          "required": true,
          "maxLength": 280
        },
        {
          "key": "who",
          "label": "Attribution",
          "type": "text",
          "required": true
        },
        {
          "key": "role",
          "label": "Role or source",
          "type": "text"
        }
      ],
      "variants": {
        "style": [
          "pull",
          "inline"
        ]
      },
      "tokens": [
        "--ds-font-display",
        "--ds-color-accent",
        "--ds-text-h3"
      ],
      "pageKinds": [
        "entry",
        "content_page"
      ]
    },
    {
      "id": "callout",
      "name": "Callout",
      "group": "text",
      "allowedRegions": [
        "main",
        "sidebar"
      ],
      "purpose": "Boxed notice: tips, warnings, standard statements.",
      "fields": [
        {
          "key": "title",
          "label": "Heading",
          "type": "text"
        },
        {
          "key": "body",
          "label": "Body",
          "type": "richTextBasic",
          "maxLength": 300
        },
        {
          "key": "tone",
          "label": "Tone",
          "type": "enum",
          "options": [
            "info",
            "tip",
            "warning"
          ],
          "default": "info"
        }
      ],
      "variants": {
        "icon": [
          "on",
          "off"
        ]
      },
      "tokens": [
        "--ds-color-callout-{tone}",
        "--ds-radius-md",
        "--ds-space-4"
      ],
      "pageKinds": [
        "entry",
        "content_page"
      ]
    },
    {
      "id": "faq",
      "name": "FAQ",
      "group": "text",
      "allowedRegions": [
        "main"
      ],
      "purpose": "Expandable questions and answers.",
      "fields": [
        {
          "key": "title",
          "label": "Heading",
          "type": "text"
        },
